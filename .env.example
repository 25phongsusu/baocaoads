# ==========================================
# CẤU HÌNH KẾT NỐI META MARKETING API (FACEBOOK ADS)
# ==========================================

# 1. Access Token (User Token hoặc System User Token có quyền ads_read, ads_management)
META_ACCESS_TOKEN=

# 2. App Secret của Meta App (Dùng để tạo appsecret_proof mã hoá bảo mật theo chuẩn Meta)
META_APP_SECRET=

# 3. ID Tài khoản quảng cáo duy nhất của bạn (Ví dụ: act_123456789012345 hoặc 1234567890)
META_AD_ACCOUNT_ID=

# 4. Phiên bản Meta Graph API (mặc định v21.0)
META_GRAPH_API_VERSION=v21.0
